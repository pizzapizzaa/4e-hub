{
  "builds": [
    {
      "src": "admin-web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ]
  ,
  "routes": [
    { "src": "^/api/(.*)", "dest": "https://4e-hub-cf.workers.dev/api/$1" },
    { "src": "/assets/(.*)", "dest": "/admin-web/assets/$1" },
    { "src": "^/$", "dest": "/admin-web/index.html" },
    { "handle": "filesystem" },
    { "src": "\/(.*)", "dest": "/admin-web/index.html" }
  ]
}
