{
  "builds": [
    {
      "src": "admin-web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ]
  ,
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/$", "status": 302, "dest": "/admin-web/" },
    { "src": "/(.*)", "dest": "/admin-web/index.html" }
  ]
}
