# Copy this to .env and fill in values. Never commit .env.

# System super admin (CF Worker secrets)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=   # generate: node scripts/hash-password.js <password>

# Cloudflare Worker secrets
TURSO_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=                  # min 32 random chars

# Mobile apps (EAS Secrets)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_POWERSYNC_URL=

# Admin web (Vercel Environment Variables)
VITE_API_URL=
